library(clusterProfiler)
seu_obj.Macrox<-subset(x = seu_obj, subset = cell_annotation=="Macrophages")
FeaturePlot(seu_obj.Macrox, features = "Ccr2", coord.fixed = T, order = T,
cols = c("grey", "red"))
FeaturePlot(seu_obj.Macrox, features = c("Ly6c1","Ly6c2"), coord.fixed = T, order = T,
cols = c("grey", "red"))
seu_obj.Macrox$Cells<-cellnames<-names(seu_obj.Macrox$seurat_clusters)
seu_obj.Macrox1 <- WhichCells(seu_obj.Macrox, expression =  Ccr2>1)#Ccr2 Ly6c1> 0 | Ly6c2> 0
head(seu_obj.Macrox1)
length(seu_obj.Macrox1)
seu_obj.Macrox2<-seu_obj.Macrox#subset(x = seu_obj.Macrox, subset = Cells%in%seu_obj.Macrox1)
table(seu_obj.Macrox2$group)
seu_obj.Macrox3<-JoinLayers(seu_obj.Macrox2)
seu_obj_sc<-as.SingleCellExperiment(seu_obj.Macrox3)
head(colData(seu_obj_sc))
dim(colData(seu_obj_sc))
summed <- aggregateAcrossCells(seu_obj_sc,
ids=colData(seu_obj_sc)[,c("orig.ident","group")])
summed
current <- summed#[,label==summed$cell_annotation]
currentx<-counts(current)
#colnames(currentx)<-paste0(rep(c('P01','P02','P03','P04','P05','P06'),each=2),"_",c("Hight","Low"))
colnames(currentx)<-c('P01','P02','P03','P04','P05','P06')
currentx1<-currentx[,c(4:6,1:3)]#2,4,6,8,10,12,1,3,5,7,9,11
#currentx1<-log2(currentx1+1)
head(currentx1)
gsvapar <- gsvaParam(currentx1, mmugolist, maxDiff=TRUE)
gsvapar.Macrox3<-gsva(gsvapar)
head(gsvapar.Macrox3)
dim(gsvapar.Macrox3)
designx <- cbind(WT=1,WTHF=c(rep(0,3),rep(1,3)))
designx
## fit the same linear model now to the GSVA enrichment scores
fitx <- lmFit(gsvapar.Macrox3, designx)
## estimate moderated t-statistics
fitx <- eBayes(fitx)
## set1 is differentially expressed
fitx1<-topTable(fitx, coef="WTHF",number=Inf)
head(fitx1)
dim(fitx1)
fitx2<-fitx1[rownames(fitx1)%in%c(mubiaogo2$IDs),]#mubiaogo1$IDs,
dim(fitx2)
fitx3<-fitx2[fitx2$adj.P.Val<0.1,]
dim(fitx3)
gsvapar.Macrox4<-gsvapar.Macrox3[rownames(gsvapar.Macrox3)%in%rownames(fitx2),]#fitx3
rownames(gsvapar.Macrox4)<-unlist(lapply(rownames(gsvapar.Macrox4),function(x){
mmugo@annot$Annot[which(mmugo@annot$GOALL==x)[1]]
}))
gsvapar.Macrox4
annotation_col = data.frame(
Groups = factor(rep(c("WT", "HF"), each=3))
)
rownames(annotation_col) = colnames(gsvapar.Macrox4)
annotation_col
pheatmap(gsvapar.Macrox4,scale = "row",cluster_rows = TRUE,cluster_cols = F,
clustering_distance_rows = "correlation",clustering_distance_cols = "euclidean",
show_rownames = T, show_colnames = F,clustering_method = "complete",
color = colorRampPalette(c("navy", "white", "firebrick3"))(50),
annotation_col = annotation_col,border_color = NA)
gsvapar.Macrox4
write.csv(gsvapar.Macrox4,file = "gsvapar.Macrox4.samples20250612.csv")
