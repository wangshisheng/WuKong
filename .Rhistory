##数据前处理
data_ori <- read.csv(datafile,row.names = 1)
labels <- as.character(data_ori[1, ])
labelsx <- factor(as.character(data_ori[1, ]))
data_body <- data_ori[-1, ]
new_order <- unlist(lapply(levels(labelsx), function(l) which(labels == l)))
data_reordered <- data_body[, new_order]
data_ori <- rbind(Label = labels[new_order], data_reordered)
data_ori1<-data_ori[-1,]
data_ori2 <- data.frame(
lapply(data_ori1, function(x) as.numeric(as.character(x))),
check.names = FALSE
)
rownames(data_ori2)<-rownames(data_ori1)
data_ori2[data_ori2 == 0] <- NA
#venn or upset
group_info <- as.character(unlist(data_ori[1, ]))
names(group_info) <- colnames(data_ori2)
group_samples <- split(
names(group_info),
group_info
)
detect_cutoff <- 1
venn_list <- lapply(
group_samples,
function(samples){
tmp <- data_ori2[, samples]
rownames(data_ori2)[
rowMeans(!is.na(tmp)) >= detect_cutoff
]
}
)
detect_summary <- data.frame(
Group = names(venn_list),
Metabolites = sapply(venn_list,length)
)
all_metabolites <- unique(unlist(venn_list))
upset_df <- data.frame(
Metabolite = all_metabolites,
stringsAsFactors = FALSE
)
upset_df$Group <- lapply(
upset_df$Metabolite,
function(met){
names(venn_list)[sapply(venn_list, function(x) met %in% x)]
}
)
p.upset <- ggplot(upset_df, aes(x = Group)) +
geom_bar(fill = "#4DBBD5", color = "black", width = 0.7) +
scale_x_upset(
n_intersections = 5
) +
labs(
title = "Metabolite Detection UpSet Plot",
x = "Group Intersection",
y = "Number of Metabolites"
) +
theme_bw(base_size = 14) +
theme(
plot.title = element_text(hjust = 0.5, face = "bold"),
axis.title = element_text(size = 13, face = "bold")
)
p.upset
library(ComplexUpset)
# 1. 获取全部代谢物
all_metabolites <- unique(unlist(venn_list))
# 2. 构建 upset_df
upset_df <- data.frame(
Metabolite = all_metabolites,
stringsAsFactors = FALSE
)
upset_df$Group <- lapply(
upset_df$Metabolite,
function(met){
names(venn_list)[sapply(venn_list, function(x) met %in% x)]
}
)
# 3. 去掉空集合，保险处理
upset_df <- upset_df[lengths(upset_df$Group) > 0, ]
head(upset_df)
dim(upset_df)
ggplot(upset_df, aes(x = Group)) +
geom_bar(fill = "#4DBBD5", color = "black", width = 0.7) +
scale_x_upset() +
labs(
title = "Metabolite Detection UpSet Plot",
x = "Group Intersection",
y = "Number of Metabolites"
) +
theme_classic(base_size = 14) +
theme(
plot.title = element_text(
hjust = 0.5,
face = "bold"
),
axis.title.x = element_text(
size = 13,
face = "bold"
),
axis.title.y = element_text(
size = 13,
face = "bold"
),
axis.text.x = element_text(size = 10),
axis.text.y = element_text(size = 10)
)
all_metabolites <- unique(unlist(venn_list))
upset_mat <- data.frame(
Metabolite = all_metabolites,
stringsAsFactors = FALSE
)
for(g in names(venn_list)){
upset_mat[[g]] <- upset_mat$Metabolite %in% venn_list[[g]]
}
head(upset_mat)
upset(
upset_mat,
intersect = names(venn_list),
name = "Group",
width_ratio = 0.2,
min_size = 1,
base_annotations = list(
"Intersection size" = intersection_size(
text = list(size = 4)
)
)
) +
ggtitle("Metabolite Detection UpSet Plot") +
theme(
plot.title = element_text(
hjust = 0.5,
face = "bold",
size = 16
)
)
upset(
upset_mat,
intersect = names(venn_list),
name = "Group",
width_ratio = 0.2,
min_size = 1,
base_annotations = list(
"Intersection size" = intersection_size(
text = list(size = 4)
)
)
)
