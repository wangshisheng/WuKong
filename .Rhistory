setwd("H:\\WSS\\Part-time-work\\jianzhiqun\\YHD_深圳Smart_多组学检测分析平台_代谢组\\R\\newdata20260730")#setwd("E:\\LJ\\20260624_WSH_Metabolomics\\REPORT")#setwd("E:/LJ/20260414_WZS/data analysis/")##数据在哪里就把路径设置在哪里
library(ComplexHeatmap)
library(ggpubr)
library(tidyverse)
library(ggplot2)
library(readxl)
library(yaml)
#library(WebGestaltR)
library(data.table)
library(kableExtra)
ht_opt$message = FALSE
library(readr)
library(rstatix)
library(xlsx)
library(openxlsx)
library(impute)
library(FactoMineR)
library(factoextra)
library(ggsci)
library(pheatmap)
library(clusterProfiler)
library(enrichplot)
library(dplyr)
library(patchwork)
library(ggvenn)
library(ggupset)
##文件名字
datafile<-datafilex<-"正负离子合并的峰表1.xlsx"#"data_ori2.csv"
groupfile<-"bijiao_1.csv"
orgid<-"hsa"
vennif<-"venn"#如果设置"upset"，则画upset图不画venn图
##
log2FC <- 0.585
FC <- 1.5 #修改FC的阈值只修改此处
pvalue <- 0.05
FC.yz<-log2(1.5)#差异倍数阈值
p.yz<-0.05#显著阈值
QC_avilable <- T #ori文件有QC数据即为T，否则F
##
#data_ori <- read.csv(datafile)
data_orix1<-read.xlsx(datafile)
data_ori<-data_orix1[-1,-c(2:13)]
data_ori$ID[1]<-"Label"
comparison <- read.csv(groupfile,header = T)
if(QC_avilable){
data_ori_QC<-data_ori[,c(1,grep("QC",as.character(data_ori[1,]),ignore.case = T))]
dat <- data_ori_QC[-1, ]
metabolite <- dat$ID
qc_mat <- dat[, -1]
qc_mat <- data.frame(
lapply(qc_mat, function(x) as.numeric(as.character(x))),
check.names = FALSE
)
##qc_mat<-log2(qc_mat+1)
rownames(qc_mat) <- metabolite
cv_df <- data.frame(
Metabolite = rownames(qc_mat),
Mean = apply(qc_mat, 1, mean, na.rm = TRUE),
SD = apply(qc_mat, 1, sd, na.rm = TRUE)
)
cv_df$CV <- cv_df$SD / cv_df$Mean
cv_df$CV_Group <- cut(
cv_df$CV,
breaks = c(-Inf, 0.05, 0.20, 0.30, Inf),
labels = c(
"[0,0.05]",
"(0.05,0.2]",
"(0.2,0.3]",
">0.3"
),
right = TRUE
)
cv_count <- cv_df %>%
count(CV_Group)
p <- ggplot(
cv_count,
aes(
x = CV_Group,
y = n
)
) +
geom_bar(
stat = "identity",
width = 0.7,
fill = "#4DBBD5"
) +
geom_text(
aes(label = n),
vjust = -0.4,
size = 5
) +
labs(
x = "CV Range",
y = "Number of Metabolites",
title = "Distribution of Metabolite CV"
) +
theme_bw(base_size = 14) +
theme(
panel.grid = element_blank(),
plot.title = element_text(
hjust = 0.5,
face = "bold"
)
) +
expand_limits(
y = max(cv_count$n) * 1.1
)
ggsave(
"CV_distribution_barplot.pdf",
p,
width = 6,
height = 5
)
ggsave(
"CV_distribution_barplot.png",
p,
width = 6,
height = 5,
dpi = 300
)
dir.create("./1.2 数据标准化及质控", recursive =T,showWarnings = FALSE)
file.copy("CV_distribution_barplot.png", "./1.2 数据标准化及质控", overwrite = TRUE)
data_ori_noQC<-data_ori[,-c(grep("QC",as.character(data_ori[1,]),ignore.case = T))]
write.csv(data_ori_noQC,paste0("./data_ori_noQC.csv"),row.names = F, fileEncoding = "UTF-8")
datafile<-"data_ori_noQC.csv"
write.csv(data_ori, paste0("./data_withQC.csv"), row.names = F, fileEncoding = "UTF-8")
}
##数据前处理
data_ori <- read.csv(datafile,row.names = 1)
labels <- as.character(data_ori[1, ])
labelsx <- factor(as.character(data_ori[1, ]))
data_body <- data_ori[-1, ]
new_order <- unlist(lapply(levels(labelsx), function(l) which(labels == l)))
data_reordered <- data_body[, new_order]
data_ori <- rbind(Label = labels[new_order], data_reordered)
data_ori1<-data_ori[-1,]
data_ori2 <- data.frame(
lapply(data_ori1, function(x) as.numeric(as.character(x))),
check.names = FALSE
)
rownames(data_ori2)<-rownames(data_ori1)
data_ori2[data_ori2 == 0] <- NA
#venn or upset
group_info <- as.character(unlist(data_ori[1, ]))
names(group_info) <- colnames(data_ori2)
group_samples <- split(
names(group_info),
group_info
)
detect_cutoff <- 1
venn_list <- lapply(
group_samples,
function(samples){
tmp <- data_ori2[, samples]
rownames(data_ori2)[
rowMeans(!is.na(tmp)) >= detect_cutoff
]
}
)
detect_summary <- data.frame(
Group = names(venn_list),
Metabolites = sapply(venn_list,length)
)
