dim(seu_obj.Macrox4)
seu_obj.Macrox4[[5]][seu_obj.Macrox4[[5]]==0]<-0.000001
seu_obj.Macrox4$Threshold<-c("NoChange")
seu_obj.Macrox4$Threshold[seu_obj.Macrox4[[2]]>=log2(1.5) & seu_obj.Macrox4[[5]] <= 0.05]<-c("UP")
seu_obj.Macrox4$Threshold[seu_obj.Macrox4[[2]]<=log2(1/1.5) & seu_obj.Macrox4[[5]] <= 0.05]<-c("DOWN")
ggplot(data=seu_obj.Macrox4,aes(x=avg_log2FC,y=-log10(p_val_adj),
colour=Threshold,size=Threshold))+
theme_bw()+
theme(panel.grid.minor = element_blank() ,panel.grid.major = element_blank())+
geom_hline(yintercept =-log10(0.05),col="grey60",lty=2,lwd=0.5)+
geom_vline(xintercept =log2(1.5),col="grey60",lty=2,lwd=0.5)+
geom_vline(xintercept =log2(1/1.5),col="grey60",lty=2,lwd=0.5)+
geom_point(alpha=0.9)+theme(legend.position ="right")+
scale_color_manual(values=c("blue","grey80","red"))+
scale_size_manual(values = c(2,1,2))+
xlab("Fold Change (log2)") + ylab("P Value (-log10)")
